# Matchly AI Environment Configuration
PROJECT_NAME="Matchly AI - Intelligent Resume & Job Description Matching System"
API_V1_PREFIX="/api"

# Model
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# Smart Match Engine Configurable Weights (Must sum to 1.0)
WEIGHT_REQUIRED_SKILLS=0.40
WEIGHT_SEMANTIC_SIMILARITY=0.25
WEIGHT_EXPERIENCE=0.20
WEIGHT_PREFERRED_SKILLS=0.10
WEIGHT_EDUCATION=0.05

# Match Thresholds
SEMANTIC_MATCH_HIGH_THRESHOLD=0.70
SEMANTIC_MATCH_PARTIAL_THRESHOLD=0.35

# File Limits
MAX_FILE_SIZE_BYTES=15728640

# Database
DATABASE_URL="sqlite:///./matchly.db"

# Server Host and Port
PORT=8000
HOST="0.0.0.0"
